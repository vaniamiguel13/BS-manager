# Nome que aparece no topo da aplicação
COMPANY_NAME=BS Manager

# Só com Docker: domínio público (aponte o registo DNS A para o IP do servidor)
DOMAIN=gestao.exemplo.pt

# Gere uma chave com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Só com Docker
POSTGRES_PASSWORD=

# Primeiro administrador (criado só se a base de dados estiver vazia)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PASSWORD=

APP_TIMEZONE=Europe/Lisbon
DEFAULT_VACATION_DAYS=22
# Feriados municipais/tolerâncias (MM-DD separados por vírgula), ex.: 06-13 = Santo António (Lisboa)
EXTRA_HOLIDAYS=
