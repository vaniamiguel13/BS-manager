# Postgres connection strings — from Neon (or any Postgres provider).
# DATABASE_URL: pooled connection (used by the app at runtime).
# DIRECT_URL: direct/unpooled connection (used by Prisma Migrate).
# On Neon, copy both from your project's "Connect" dialog.
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/bsmanager?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/bsmanager?sslmode=require"

# NextAuth secret used to sign session tokens. Generate your own with `npx auth secret`.
AUTH_SECRET="replace-me"
