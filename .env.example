# Local Docker development; generate a private .env with scripts/setup-local.py.
SECRET_KEY=
POSTGRES_OWNER_PASSWORD=
POSTGRES_PASSWORD=
WEB_PORT=8000
COMPANY_NAME=BS Manager
APP_TIMEZONE=Europe/Lisbon
DEFAULT_VACATION_DAYS=22
EXTRA_HOLIDAYS=
# Optional one-time bootstrap. Prefer the interactive create-admin command.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional local encrypted backup profile (prepare directories/files first).
# Match BACKUP_UID/GID to the owner of the private backup files on the host.
# BACKUP_UID=1000
# BACKUP_GID=1000
# BACKUP_DIR=/absolute/private/backup-output
# BACKUP_PGPASS_FILE=/absolute/private/pgpass
# BACKUP_RECIPIENTS_FILE=/absolute/private/public-age-recipients
